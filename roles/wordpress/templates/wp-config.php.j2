<?php
/**
 * Managed by Ansible (role: wordpress). Ручные изменения будут перезаписаны.
 * wp-config.php для {{ wordpress_site_url }}
 */

define( 'DB_NAME', '{{ wordpress_db_name }}' );
define( 'DB_USER', '{{ wordpress_db_user }}' );
define( 'DB_PASSWORD', '{{ wordpress_db_password }}' );
define( 'DB_HOST', '{{ wordpress_db_host }}' );
define( 'DB_CHARSET', '{{ wordpress_db_charset }}' );
define( 'DB_COLLATE', '{{ wordpress_db_collate }}' );

/** @see https://wp.salts.generate/ — уникальные ключи и соли */
define( 'AUTH_KEY',         '{{ wordpress_salts.auth_key }}' );
define( 'SECURE_AUTH_KEY',  '{{ wordpress_salts.secure_auth_key }}' );
define( 'LOGGED_IN_KEY',    '{{ wordpress_salts.logged_in_key }}' );
define( 'NONCE_KEY',        '{{ wordpress_salts.nonce_key }}' );
define( 'AUTH_SALT',        '{{ wordpress_salts.auth_salt }}' );
define( 'SECURE_AUTH_SALT', '{{ wordpress_salts.secure_auth_salt }}' );
define( 'LOGGED_IN_SALT',   '{{ wordpress_salts.logged_in_salt }}' );
define( 'NONCE_SALT',       '{{ wordpress_salts.nonce_salt }}' );

$table_prefix = '{{ wordpress_table_prefix }}';

define( 'WP_DEBUG', {{ 'true' if wordpress_debug | bool else 'false' }} );
{% if wordpress_debug | bool %}
define( 'WP_DEBUG_LOG', {{ 'true' if not wordpress_disable_wp_debug_logging | bool else 'false' }} );
define( 'WP_DEBUG_DISPLAY', {{ 'true' if wordpress_wp_debug_display | bool else 'false' }} );
{% else %}
define( 'WP_DEBUG_LOG', false );
define( 'WP_DEBUG_DISPLAY', false );
define( 'WP_DISABLE_FATAL_ERROR_HANDLER', false );
{% endif %}
@ini_set( 'display_errors', 0 );
define( 'SCRIPT_DEBUG', {{ 'true' if wordpress_script_debug | bool else 'false' }} );
define( 'SAVEQUERIES', {{ 'true' if wordpress_save_queries | bool else 'false' }} );

{% if wordpress_env_type == 'production' %}
/* Production: файловый менеджер встроенных редакторов отключён */
define( 'DISALLOW_FILE_EDIT', true );
define( 'WP_AUTO_UPDATE_CORE', 'minor' );
{% endif %}
{% if wordpress_force_ssl_admin | bool %}
define( 'FORCE_SSL_ADMIN', true );
{% endif %}
{% if wordpress_disable_wp_cron | bool %}
/* Планировщик запускается системным cron (см. tasks/cron.yml) */
define( 'DISABLE_WP_CRON', true );
{% endif %}
{% if wordpress_site_url is match('https://') %}
/* Сайт за TLS-прокси */
if ( isset( $_SERVER['HTTP_X_FORWARDED_PROTO'] ) && 'https' === $_SERVER['HTTP_X_FORWARDED_PROTO'] ) {
    $_SERVER['HTTPS'] = 'on';
}
{% endif %}
{% for key, value in wordpress_config_extra | dict2items %}
define( '{{ key }}', {{ value if value is number else "'" ~ value ~ "'" }} );
{% endfor %}

if ( ! defined( 'ABSPATH' ) ) {
    define( 'ABSPATH', __DIR__ . '/' );
}
require_once ABSPATH . 'wp-settings.php';
