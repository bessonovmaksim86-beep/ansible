; Managed by Ansible (role: php_fpm) — настройки под WordPress
[PHP]
max_execution_time = {{ php_fpm_max_execution_time }}
max_input_time = {{ php_fpm_max_input_time }}
max_input_vars = {{ php_fpm_max_input_vars }}
memory_limit = {{ php_fpm_memory_limit }}
upload_max_filesize = {{ php_fpm_upload_max_filesize }}
post_max_size = {{ php_fpm_post_max_size }}
date.timezone = {{ php_fpm_date_timezone }}
display_errors = {{ php_fpm_display_errors }}
log_errors = On
expose_php = Off
session.cookie_httponly = 1

[opcache]
opcache.enable = {{ 1 if php_fpm_opcache_enabled | bool else 0 }}
opcache.memory_consumption = {{ php_fpm_opcache_memory_consumption }}
opcache.interned_strings_buffer = 16
opcache.max_accelerated_files = 20000
opcache.validate_timestamps = {{ 1 if wordpress_env_type | default('development') == 'development' else 0 }}
opcache.revalidate_freq = 2
